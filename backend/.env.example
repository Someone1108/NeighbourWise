DATABASE_URL=
MAPBOX_TOKEN=

# Production API security
# Set this to your deployed frontend URL, for example:
# FRONTEND_ORIGIN=https://your-neighbourwise-site.vercel.app
FRONTEND_ORIGIN=

# Optional comma-separated list if you have multiple frontend URLs.
# CORS_ORIGINS=https://your-neighbourwise-site.vercel.app,https://your-preview-url.vercel.app
CORS_ORIGINS=

# Required in production if backend NODE_ENV=production.
# The frontend must use the same value as VITE_API_ACCESS_TOKEN.
API_ACCESS_TOKEN=

# EPA Victoria Environment Monitoring API / AirWatch
# Get this from https://portal.api.epa.vic.gov.au/ after subscribing to the API product.
EPA_AIRWATCH_API_KEY=

# Defaults target the Environment Monitoring v1 API. Override these if the
# developer portal shows a different gateway/path after login.
EPA_AIRWATCH_API_BASE_URL=https://gateway.api.epa.vic.gov.au/environmentMonitoring/v1
EPA_AIRWATCH_SITES_PATH=/sites?environmentalSegment=air
EPA_AIRWATCH_SITE_PARAMETERS_PATH=/sites/{siteId}/parameters
EPA_AIRWATCH_TIMEOUT_MS=10000
